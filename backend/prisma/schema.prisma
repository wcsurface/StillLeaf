datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SubscriptionTier {
  FREE
  MONTHLY
  ANNUAL
  LIFETIME
}

enum TaskType {
  WATER
  FEED
  ROTATE
  TRIM
  PHOTO
  REPOTTING
}

model User {
  id                    String           @id @default(uuid())
  email                 String           @unique
  passwordHash          String?
  displayName           String?
  avatarUrl             String?
  authProvider          String           @default("EMAIL")
  fcmToken              String?
  tier                  SubscriptionTier @default(FREE)
  freeScansRemaining    Int              @default(3)
  playPurchaseToken     String?
  subscriptionExpiresAt DateTime?
  plants                Plant[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([email])
  @@index([tier])
}

model Plant {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname            String
  botanicalName       String
  commonName          String
  sunlightRequirement String       @default("Bright Indirect Light")
  idealTemperature    String?
  idealHumidity       String?
  waterIntervalDays   Int          @default(7)
  feedIntervalDays    Int          @default(30)
  rotateIntervalDays  Int          @default(14)
  trimIntervalDays    Int          @default(60)
  careSummary         String?      @db.Text
  photos              PlantPhoto[]
  careLogs            CareLog[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([userId])
}

model PlantPhoto {
  id                   String   @id @default(uuid())
  plantId              String
  plant                Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  photoUrl             String
  imageKey             String   @default("")
  takenAt              DateTime @default(now())
  isQuarterlyMilestone Boolean  @default(false)
  note                 String?

  @@index([plantId, takenAt])
}

model CareLog {
  id          String   @id @default(uuid())
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  taskType    TaskType
  completedAt DateTime @default(now())
  notes       String?

  @@index([plantId, completedAt])
}

model AffiliateProduct {
  id                 String   @id @default(uuid())
  category           String   // e.g., "SOIL_AROID", "GROW_LIGHT", "MOISTURE_METER", "FERTILIZER_ORGANIC"
  title              String
  brand              String
  recommendationNote String   @db.Text
  affiliateUrl       String
  imageUrl           String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  @@index([category])
}
