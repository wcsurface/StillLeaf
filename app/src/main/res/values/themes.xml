<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base App Theme (AppCompat Light NoActionBar for 100% theme inflation compatibility) -->
    <style name="Theme.StillLeaf" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">#F7F4E9</item>
        <item name="android:statusBarColor">#F7F4E9</item>
        <item name="android:navigationBarColor">#F7F4E9</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Official Starting Splash Screen Theme for Android 12+ and All Versions -->
    <style name="Theme.StillLeaf.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/still_leaf_sage</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/still_leaf_sage</item>
        <item name="postSplashScreenTheme">@style/Theme.StillLeaf</item>
    </style>
</resources>
